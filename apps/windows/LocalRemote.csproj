<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
    <Version>0.2.0-beta.1</Version>
    <Product>LocalRemote</Product>
    <AssemblyName>LocalRemote</AssemblyName>
    <RootNamespace>LocalRemote</RootNamespace>
    <Description>Local-first remote desktop</Description>
    <ApplicationIcon>../../assets/brand/LocalRemote.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../assets/brand/LocalRemote.ico" Link="LocalRemote.ico" />
    <Resource Include="../../assets/brand/icon.png" Link="LocalRemote.png" />
  </ItemGroup>
</Project>
