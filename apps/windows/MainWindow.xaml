<Window x:Class="LocalRemoteDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalRemoteDesktop" Title="Local Remote Desktop · 0.3.0-alpha.2" Icon="LocalRemoteDesktop.ico" Width="1100" Height="730" MinWidth="820" MinHeight="480" Background="#F7F8FF" Foreground="#282C67" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LocalRemoteDesktop;component/BrandResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid>
 <Grid x:Name="HomeShell"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#F7F8FF" BorderBrush="#E2E5F3" BorderThickness="0,0,1,0"><StackPanel Margin="12,28,12,12">
 <TextBlock Text="Local Remote Desktop" FontSize="12" Margin="8,0,0,24"/>
 <RadioButton x:Name="NavConnect" Content="{local:Translate Key='连接'}" Tag="connect" GroupName="navigation" Style="{StaticResource NavigationItem}" Checked="NavigateClick" IsChecked="True"/>
 <RadioButton x:Name="NavShare" Content="{local:Translate Key='共享此设备'}" Tag="share" GroupName="navigation" Style="{StaticResource NavigationItem}" Checked="NavigateClick"/>
 <RadioButton x:Name="NavSettings" Content="{local:Translate Key='设置'}" Tag="settings" GroupName="navigation" Style="{StaticResource NavigationItem}" Checked="NavigateClick"/>
 </StackPanel></Border>
 <Grid Grid.Column="1" Background="White">
 <Grid x:Name="ConnectPage" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,28"><TextBlock Text="{local:Translate Key='连接'}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{local:Translate Key='选择要连接的附近设备。'}" Foreground="#656982" Margin="0,8,0,0"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
 <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="{local:Translate Key='刷新设备'}" Click="RefreshDevicesClick" DockPanel.Dock="Right" Padding="8,4"/><TextBlock Text="{local:Translate Key='附近设备'}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
 <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="DeviceSearchStatus" Foreground="#656982" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
 <ListBox x:Name="DeviceList" SelectionChanged="DeviceSelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,14"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Address}" Foreground="#656982" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 </DockPanel>
 <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <TextBlock x:Name="SelectedDeviceName" Text="{local:Translate Key='输入目标IP'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
     <StackPanel x:Name="ConnectionFields" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
     <TextBlock x:Name="TargetIpLabel" Text="{local:Translate Key='目标IP'}" VerticalAlignment="Center" Margin="0,0,0,6" FontSize="12"/>
     <Grid Width="Auto">
      <TextBox x:Name="Address" Padding="4,4,23,4" AutomationProperties.Name="{local:Translate Key='目标IP'}" ToolTip="{local:Translate Key='目标设备的局域网 IPv4；优先恢复上次地址，首次需改成目标 IP。'}"/>
      <Button x:Name="DiscoverButton" Content="⌄" Padding="0" Width="20" Margin="1" HorizontalAlignment="Right" Click="DiscoverClick" ToolTip="{local:Translate Key='选择局域网设备'}" AutomationProperties.Name="{local:Translate Key='选择局域网设备'}" Background="Transparent" BorderThickness="0"/>
     </Grid>
     <TextBlock Text="{local:Translate Key='密码'}" VerticalAlignment="Center" Margin="0,14,0,6" FontSize="12"/>
     <PasswordBox x:Name="Secret" Width="Auto" Padding="4,4" ToolTip="{local:Translate Key='填写目标设备上显示的配对密码'}"/>
    </StackPanel>

 <TextBlock Text="{local:Translate Key='画质'}" Margin="0,18,0,6"/><ComboBox SelectedIndex="{Binding ElementName=Quality,Path=SelectedIndex,Mode=TwoWay}" Padding="4"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox>
 <Button x:Name="StartConnection" Content="{local:Translate Key='连接'}" Click="ConnectClick" Style="{StaticResource BrandConnectButton}" Padding="12,10" Margin="0,24,0,12"/>
 <TextBlock Text="{local:Translate Key='首次连接需要目标设备的配对密码。'}" Foreground="#656982" FontSize="12" TextWrapping="Wrap"/>
 <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#656982"/>
 </StackPanel></ScrollViewer>
 </Grid></Grid>
 <ContentControl x:Name="SharingPage" Visibility="Collapsed" Margin="8" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Margin="32" VerticalScrollBarVisibility="Auto"><StackPanel Width="520" HorizontalAlignment="Left">
 <TextBlock Text="{local:Translate Key='设置'}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,24"/>
 <TextBlock Text="{local:Translate Key='剪贴板'}" FontWeight="SemiBold" Margin="0,0,0,10"/>
 <CheckBox Content="{local:Translate Key='同步文字'}" IsChecked="{Binding ElementName=ClipboardSync,Path=IsChecked,Mode=TwoWay}" Margin="0,6"/>
 <CheckBox Content="{local:Translate Key='同步文件'}" IsChecked="{Binding ElementName=FileSync,Path=IsChecked,Mode=TwoWay}" Margin="0,6"/>
 <Button Content="{local:Translate Key='打开接收目录'}" Click="OpenFilesClick" HorizontalAlignment="Left" Padding="8,4" Margin="0,10,0,18"/>
 <Separator/><TextBlock Text="{local:Translate Key='键盘与连接'}" FontWeight="SemiBold" Margin="0,18,0,10"/>
 <CheckBox Content="{local:Translate Key='Windows 快捷键'}" IsChecked="{Binding ElementName=WindowsShortcuts,Path=IsChecked,Mode=TwoWay}" Margin="0,6"/>
 <CheckBox Content="{local:Translate Key='自动重连'}" IsChecked="{Binding ElementName=Reconnect,Path=IsChecked,Mode=TwoWay}" Margin="0,6"/>
 <Button Content="{local:Translate Key='忘记此连接'}" Click="ForgetClick" HorizontalAlignment="Left" Padding="8,4" Margin="0,10,0,18"/>
 <Separator/><TextBlock Text="{local:Translate Key='语言'}" FontWeight="SemiBold" Margin="0,18,0,10"/><StackPanel Orientation="Horizontal"><Button Content="English" Tag="en" Click="LanguageClick" Padding="10,5" Margin="0,0,8,0"/><Button Content="简体中文" Tag="zh-Hans" Click="LanguageClick" Padding="10,5"/></StackPanel>
 <Separator Margin="0,18"/><TextBlock Text="{local:Translate Key='诊断'}" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox Content="{local:Translate Key='显示性能数据'}" IsChecked="{Binding ElementName=ShowPerformance,Path=IsChecked,Mode=TwoWay}" Margin="0,6"/><Button Content="{local:Translate Key='复制诊断'}" Click="DiagnosticsClick" HorizontalAlignment="Left" Padding="8,4" Margin="0,10"/>
 </StackPanel></ScrollViewer>
 </Grid></Grid>
 <DockPanel x:Name="SessionPage" Visibility="Collapsed">
  <DockPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="10,6,10,6">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="FullscreenButton" Content="⛶" AutomationProperties.Name="{local:Translate Key='全屏'}" ToolTip="{local:Translate Key='F11 全屏 / 退出全屏'}" Click="FullscreenClick" Padding="8,4" Margin="8,0,6,0"/>
     <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13">
      <MenuItem x:Name="SettingsMenu" Header="⚙" ToolTip="{local:Translate Key='设置'}" AutomationProperties.Name="{local:Translate Key='设置'}" Padding="10,5">
       <MenuItem x:Name="AllowConnections" Header="{local:Translate Key='允许连接（预览）'}" Click="SharingClick"/>
       <Separator/>
       <MenuItem Header="{local:Translate Key='剪贴板'}">
        <MenuItem x:Name="ClipboardSync" Header="{local:Translate Key='同步文字'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='同步新复制的纯文本，最多 32 KiB；只对已配对的 Mac 生效。'}"/>
        <MenuItem x:Name="FileSync" Header="{local:Translate Key='同步文件'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='复制普通文件后自动传输；暂不支持文件夹。只对已配对的 Mac 生效。'}"/>
        <Separator/>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock x:Name="ClipboardStatus" Text="{local:Translate Key='文本同步：等待连接'}" FontSize="12"/></MenuItem.Header></MenuItem>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock Text="{Binding ElementName=FileStatus,Path=Text}" FontSize="12"/></MenuItem.Header></MenuItem>
       </MenuItem>
       <MenuItem Header="{local:Translate Key='键盘与连接'}">
        <MenuItem x:Name="WindowsShortcuts" Header="{local:Translate Key='Windows 快捷键'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='Ctrl 对应 Mac Command，Win 对应 Control；关闭后使用原生映射。'}"/>
        <MenuItem x:Name="Reconnect" Header="{local:Translate Key='自动重连'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True"/>
        <Separator/>
        <MenuItem x:Name="ForgetButton" Header="{local:Translate Key='忘记此连接'}" Click="ForgetClick"/>
       </MenuItem>
       <MenuItem Header="{local:Translate Key='语言'}">
        <MenuItem x:Name="LanguageEnglish" Header="English" IsCheckable="True" Tag="en" Click="LanguageClick"/>
        <MenuItem x:Name="LanguageChinese" Header="简体中文" IsCheckable="True" Tag="zh-Hans" Click="LanguageClick"/>
       </MenuItem>
       <Separator/>
       <MenuItem Header="{local:Translate Key='打开接收目录'}" Click="OpenFilesClick"/>
       <MenuItem x:Name="ShowPerformance" Header="{local:Translate Key='显示性能数据'}" IsCheckable="True" StaysOpenOnClick="True"/>
       <MenuItem Header="{local:Translate Key='复制诊断'}" Click="DiagnosticsClick"/>
      </MenuItem>
     </Menu>
   </StackPanel>
   <WrapPanel VerticalAlignment="Center">
    <TextBlock x:Name="ConnectionTarget" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="Quality" SelectedIndex="0" Width="88" Padding="3,3" ToolTip="{local:Translate Key='画质；连接后切换会短暂重连'}"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox>
    <Button x:Name="ConnectButton" Content="{local:Translate Key='连接'}" Click="ConnectClick" Margin="6,0,0,0" Padding="12,5" Style="{StaticResource BrandConnectButton}"/>
   </WrapPanel>
  </DockPanel>
   <DockPanel x:Name="TransferNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,0,12,8">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button x:Name="CancelFiles" Content="{local:Translate Key='取消传输'}" Click="CancelFilesClick" IsEnabled="False" Visibility="Collapsed" Margin="8,0" Padding="6,2"/>
     <Button x:Name="DismissFileNotice" Content="{local:Translate Key='收起'}" Click="DismissFilesClick" Padding="6,2"/>
    </StackPanel>
    <TextBlock x:Name="FileStatus" Text="{local:Translate Key='文件同步：等待连接'}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="{local:Translate Key='输入目标IP和配对密码，连接后点击画面开始操作。'}" Margin="12,8" TextWrapping="Wrap"/>
  <Border x:Name="Surface" Background="Black" Focusable="True" ClipToBounds="True" InputMethod.IsInputMethodEnabled="False" KeyboardNavigation.TabNavigation="None"><Image x:Name="Desktop" Stretch="Uniform"/></Border>
 </DockPanel>
 </Grid>
</Window>
