<Window x:Class="LocalRemoteDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalRemoteDesktop" Title="Local Remote Desktop · 0.3.0-alpha.2" Icon="LocalRemoteDesktop.ico" Width="920" Height="660" MinWidth="820" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#FFFFFF" Foreground="#202435" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LocalRemoteDesktop;component/BrandResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid>
 <Grid x:Name="HomeShell"><Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#F6F7FA" BorderBrush="#E5E8F0" BorderThickness="0,0,1,0"><Grid Margin="12,24,12,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock x:Name="LocalDeviceName" FontSize="12" Foreground="#697183" Margin="8,0,0,24" TextWrapping="Wrap"/>
 <RadioButton x:Name="NavConnect" Content="{local:Translate Key='连接'}" Tag="connect" GroupName="navigation" Style="{StaticResource NavigationItem}" Checked="NavigateClick" IsChecked="True"/>
 <RadioButton x:Name="NavShare" Content="{local:Translate Key='共享此设备'}" Tag="share" GroupName="navigation" Style="{StaticResource NavigationItem}" Checked="NavigateClick"/>
 </StackPanel>
 <RadioButton Grid.Row="2" x:Name="NavSettings" Content="{local:Translate Key='设置'}" Tag="settings" GroupName="navigation" Style="{StaticResource NavigationItem}" Checked="NavigateClick"/>
 </Grid></Border>
 <Grid Grid.Column="1" Background="White">
 <Grid x:Name="ConnectPage" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,28"><DockPanel><Button x:Name="ManualConnection" Content="{local:Translate Key='输入目标IP'}" Click="ManualClick" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="{local:Translate Key='连接'}" FontSize="26" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{local:Translate Key='选择你要连接并操作的设备。'}" Foreground="#697183" Margin="0,8,0,0"/></StackPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
 <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="{local:Translate Key='刷新设备'}" Click="RefreshDevicesClick" DockPanel.Dock="Right" Padding="8,4"/><TextBlock Text="{local:Translate Key='附近设备'}" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
 <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="DeviceSearchStatus" Foreground="#697183" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
 <ListBox x:Name="DeviceList" SelectionChanged="DeviceSelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,14"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SystemLabel}" Foreground="#697183" Margin="0,6,0,0"/><TextBlock Text="{Binding StateLabel}" Foreground="#697183" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
 </DockPanel>
 <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <TextBlock x:Name="SelectedDeviceName" Text="{local:Translate Key='输入目标IP'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
 <TextBlock x:Name="SelectedDeviceSystem" Foreground="#697183" FontSize="12" Margin="0,-12,0,16"/>
     <StackPanel x:Name="ConnectionFields" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,8,0">
     <TextBlock x:Name="TargetIpLabel" Text="{local:Translate Key='目标IP'}" VerticalAlignment="Center" Margin="0,0,0,6" FontSize="12"/>
     <Grid Width="Auto">
      <TextBox x:Name="Address" IsReadOnly="True" Padding="4,4,23,4" AutomationProperties.Name="{local:Translate Key='目标IP'}" ToolTip="{local:Translate Key='目标设备的局域网 IPv4；优先恢复上次地址，首次需改成目标 IP。'}"/>
      <Button x:Name="DiscoverButton" Content="⌄" Padding="0" Width="20" Margin="1" HorizontalAlignment="Right" Click="DiscoverClick" ToolTip="{local:Translate Key='选择局域网设备'}" AutomationProperties.Name="{local:Translate Key='选择局域网设备'}" Background="Transparent" BorderThickness="0"/>
     </Grid>
     <TextBlock Text="{local:Translate Key='密码'}" VerticalAlignment="Center" Margin="0,14,0,6" FontSize="12"/>
     <PasswordBox x:Name="Secret" Width="Auto" Padding="4,4" ToolTip="{local:Translate Key='填写目标设备上显示的配对密码'}"/>
     <CheckBox x:Name="RememberPassword" Content="{local:Translate Key='记住密码'}" Margin="0,12,0,0"/>
    </StackPanel>

 <TextBlock Text="{local:Translate Key='画质'}" Margin="0,18,0,6"/><ComboBox x:Name="HomeQuality" SelectedIndex="0" Padding="4"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox>
 <Button x:Name="StartConnection" Content="{local:Translate Key='连接'}" Click="ConnectClick" Style="{StaticResource BrandConnectButton}" Padding="12,10" Margin="0,24,0,12"/>
 <TextBlock Text="{local:Translate Key='首次连接需要目标设备的配对密码。'}" Foreground="#697183" FontSize="12" TextWrapping="Wrap"/>
 <Button x:Name="ForgetButton" Content="{local:Translate Key='忘记密码'}" Click="ForgetClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
 <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#697183"/>
 </StackPanel></ScrollViewer>
 </Grid></Grid>
 <ContentControl x:Name="SharingPage" Visibility="Collapsed" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Text="{local:Translate Key='设置'}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,24"/>
 <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="White" BorderThickness="0">
 <TabItem Header="{local:Translate Key='通用'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,24,0,0" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MaxWidth="640" HorizontalAlignment="Left">
 <TextBlock Text="{local:Translate Key='语言'}" FontWeight="SemiBold" Margin="0,0,0,16"/>
 <StackPanel Orientation="Horizontal"><RadioButton x:Name="LanguageEnglish" Content="English" Tag="en" GroupName="languages" Click="LanguageClick" Margin="0,0,28,0"/><RadioButton x:Name="LanguageChinese" Content="简体中文" Tag="zh-Hans" GroupName="languages" Click="LanguageClick"/></StackPanel>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="{local:Translate Key='连接设置'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,24,0,0" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MaxWidth="640" HorizontalAlignment="Left">
 <TextBlock Text="{local:Translate Key='默认连接选项'}" FontWeight="SemiBold"/>
 <TextBlock Text="{local:Translate Key='用于下一次连接；当前会话在画面工具栏中调整。'}" Foreground="#697183" FontSize="12" Margin="0,8,0,24" TextWrapping="Wrap"/>
 <DockPanel Margin="0,0,0,20"><ComboBox x:Name="DefaultQuality" DockPanel.Dock="Right" Width="170" SelectedIndex="0"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox><TextBlock Text="{local:Translate Key='画质'}" VerticalAlignment="Center"/></DockPanel>
 <CheckBox x:Name="DefaultReconnect" Content="{local:Translate Key='自动重连'}" Margin="0,0,0,20"/>
 <CheckBox x:Name="DefaultShortcuts" Content="{local:Translate Key='Windows 快捷键'}" Margin="0,0,0,8"/>
 <TextBlock Text="{local:Translate Key='Ctrl 对应 Mac Command，Win 对应 Control；Windows 目标使用原生快捷键。'}" Foreground="#697183" FontSize="12" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="{local:Translate Key='剪贴板'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,24,0,0" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MaxWidth="640" HorizontalAlignment="Left">
 <TextBlock Text="{local:Translate Key='允许已配对设备共享剪贴板'}" FontWeight="SemiBold"/>
 <TextBlock Text="{local:Translate Key='关闭后立即停止对应同步；会话选项只能进一步限制共享。'}" Foreground="#697183" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,24"/>
 <CheckBox x:Name="GlobalClipboard" Content="{local:Translate Key='同步文字'}" IsChecked="True" Margin="0,0,0,20"/>
 <CheckBox x:Name="GlobalFiles" Content="{local:Translate Key='同步文件'}" IsChecked="True" Margin="0,0,0,20"/>
 <Button Content="{local:Translate Key='打开接收目录'}" Click="OpenFilesClick" HorizontalAlignment="Left"/>
 </StackPanel></ScrollViewer></TabItem>
 <TabItem Header="{local:Translate Key='关于'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,24,0,0" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MaxWidth="640" HorizontalAlignment="Left">
 <TextBlock Text="Local Remote Desktop" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="0.3.0-alpha.2" Foreground="#697183" Margin="0,8,0,24"/>
 <TextBlock Text="{local:Translate Key='许可'}" FontWeight="SemiBold"/><TextBlock Text="GPL-3.0-or-later" Margin="0,8,0,24"/>
 <Expander Header="{local:Translate Key='故障排查'}"><StackPanel Margin="0,16,0,0"><CheckBox Content="{local:Translate Key='显示性能数据'}" IsChecked="{Binding ElementName=ShowPerformance,Path=IsChecked,Mode=TwoWay}" Margin="0,0,0,16"/><Button Content="{local:Translate Key='复制诊断'}" Click="DiagnosticsClick" HorizontalAlignment="Left"/></StackPanel></Expander>
 </StackPanel></ScrollViewer></TabItem>
 </TabControl></Grid>
 </Grid></Grid>
 <DockPanel x:Name="SessionPage" Visibility="Collapsed">
  <DockPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="10,4,10,4" MinHeight="34">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="FullscreenButton" Content="⛶" AutomationProperties.Name="{local:Translate Key='全屏'}" ToolTip="{local:Translate Key='F11 全屏 / 退出全屏'}" Click="FullscreenClick" Padding="8,4" Margin="8,0,6,0"/>
     <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13">
      <MenuItem x:Name="SettingsMenu" Header="{local:Translate Key='会话选项'}" ToolTip="{local:Translate Key='仅用于当前连接'}" AutomationProperties.Name="{local:Translate Key='会话选项'}" Padding="10,5">
       <MenuItem Header="{local:Translate Key='剪贴板'}">
        <MenuItem x:Name="ClipboardSync" Header="{local:Translate Key='同步文字'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='同步新复制的纯文本，最多 32 KiB；只对已配对的 Mac 生效。'}"/>
        <MenuItem x:Name="FileSync" Header="{local:Translate Key='同步文件'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='复制普通文件后自动传输；暂不支持文件夹。只对已配对的 Mac 生效。'}"/>
        <Separator/>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock x:Name="ClipboardStatus" Text="{local:Translate Key='文本同步：等待连接'}" FontSize="12"/></MenuItem.Header></MenuItem>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock Text="{Binding ElementName=FileStatus,Path=Text}" FontSize="12"/></MenuItem.Header></MenuItem>
       </MenuItem>
       <MenuItem Header="{local:Translate Key='键盘与连接'}">
        <MenuItem x:Name="WindowsShortcuts" Header="{local:Translate Key='Windows 快捷键'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='Ctrl 对应 Mac Command，Win 对应 Control；关闭后使用原生映射。'}"/>
        <MenuItem x:Name="Reconnect" Header="{local:Translate Key='自动重连'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True"/>
       </MenuItem>
       <Separator/>
       <MenuItem Header="{local:Translate Key='打开接收目录'}" Click="OpenFilesClick"/>
       <MenuItem x:Name="ShowPerformance" Header="{local:Translate Key='显示性能数据'}" IsCheckable="True" StaysOpenOnClick="True"/>
       <MenuItem Header="{local:Translate Key='复制诊断'}" Click="DiagnosticsClick"/>
      </MenuItem>
     </Menu>
   </StackPanel>
   <WrapPanel VerticalAlignment="Center">
    <TextBlock x:Name="ConnectionTarget" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="Quality" SelectedIndex="0" Width="88" Padding="3,3" ToolTip="{local:Translate Key='画质；连接后切换会短暂重连'}"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox>
    <Button x:Name="ConnectButton" Content="{local:Translate Key='连接'}" Click="ConnectClick" Margin="6,0,0,0" Padding="12,5" Style="{StaticResource BrandConnectButton}"/>
   </WrapPanel>
  </DockPanel>
   <DockPanel x:Name="TransferNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,0,12,8">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button x:Name="CancelFiles" Content="{local:Translate Key='取消传输'}" Click="CancelFilesClick" IsEnabled="False" Visibility="Collapsed" Margin="8,0" Padding="6,2"/>
     <Button x:Name="DismissFileNotice" Content="{local:Translate Key='收起'}" Click="DismissFilesClick" Padding="6,2"/>
    </StackPanel>
    <TextBlock x:Name="FileStatus" Text="{local:Translate Key='文件同步：等待连接'}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="{local:Translate Key='输入目标IP和配对密码，连接后点击画面开始操作。'}" Margin="12,8" TextWrapping="Wrap"/>
  <Border x:Name="Surface" Background="Black" Focusable="True" ClipToBounds="True" InputMethod.IsInputMethodEnabled="False" KeyboardNavigation.TabNavigation="None"><Image x:Name="Desktop" Stretch="Uniform"/></Border>
 </DockPanel>
 <Grid x:Name="ManualDialog" Visibility="Collapsed" Background="#66000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" PreviewKeyDown="ManualKeyDown">
  <Border Background="White" BorderBrush="#E5E8F0" BorderThickness="1" CornerRadius="14" Width="440" MaxHeight="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{local:Translate Key='手动连接'}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock x:Name="ManualDeviceName" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="ManualDeviceSystem" Foreground="#697183" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>
    <TextBlock Text="{local:Translate Key='目标IP'}" Margin="0,0,0,6"/>
    <TextBox x:Name="ManualAddress" Padding="8" MaxLength="15" TextChanged="ManualAddressChanged" AutomationProperties.Name="{local:Translate Key='目标IP'}"/>
    <TextBlock Text="{local:Translate Key='密码'}" Margin="0,16,0,6"/>
    <PasswordBox x:Name="ManualSecret" Padding="8" MaxLength="64" AutomationProperties.Name="{local:Translate Key='密码'}"/>
    <CheckBox x:Name="ManualRemember" Content="{local:Translate Key='记住密码'}" Margin="0,12,0,0"/>
    <TextBlock Text="{local:Translate Key='认证成功后安全保存。'}" Foreground="#697183" FontSize="12" Margin="0,6,0,0"/>
    <CheckBox x:Name="ManualStopSharing" Content="{local:Translate Key='停止共享并连接'}" Margin="0,12,0,0" Visibility="Collapsed"/>
    <TextBlock x:Name="ManualError" TextWrapping="Wrap" Foreground="#A82435" Margin="0,12,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
     <Button x:Name="ManualCancel" Content="{local:Translate Key='取消'}" Click="ManualCancelClick" Margin="0,0,8,0"/>
     <Button x:Name="ManualConnect" Content="{local:Translate Key='连接'}" Click="ManualConnectClick" Style="{StaticResource BrandConnectButton}"/>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </Border>
 </Grid>
 </Grid>
</Window>
