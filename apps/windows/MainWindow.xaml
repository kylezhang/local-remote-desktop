<Window x:Class="LocalRemoteDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalRemoteDesktop" Title="Local Remote Desktop · 0.3.0-alpha.5" Icon="LocalRemoteDesktop.ico" Width="600" Height="680" MinWidth="520" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#FFFFFF" Foreground="#293247" FontFamily="{x:Static local:UiTypography.Family}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" FontSize="14">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LocalRemoteDesktop;component/BrandResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid>
 <Grid x:Name="HomeShell"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid Margin="28,16,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Orientation="Horizontal">
 <Button x:Name="HomeBack" Content="{local:Translate Key='‹ 返回'}" Click="HomeBackClick" HorizontalAlignment="Left" Visibility="Collapsed" Padding="10,6"/>
 <Button x:Name="ReturnSession" Content="{local:Translate Key='返回会话'}" Click="ReturnSessionClick" Visibility="Collapsed" Margin="8,0,0,0" Padding="10,6"/>
 </StackPanel>
 <RadioButton Grid.Column="1" x:Name="NavSettings" GroupName="navigation" Tag="settings" Checked="NavigateClick" Style="{StaticResource SettingsShortcut}" AutomationProperties.Name="{local:Translate Key='设置'}">
 <StackPanel Orientation="Horizontal"><Image x:Name="SettingsGlyph" Source="{StaticResource SettingsVector}" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="{local:Translate Key='设置'}" VerticalAlignment="Center"/></StackPanel>
 </RadioButton>
 <TextBlock x:Name="LocalDeviceName" Visibility="Collapsed"/>
 </Grid>
 <Grid Grid.Row="1" Background="White">
 <ScrollViewer x:Name="EntryPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
 <StackPanel Margin="32,18,32,45" VerticalAlignment="Center">
 <TextBlock x:Name="EntryPrompt" Text="{local:Translate Key='你想如何使用？'}" Style="{StaticResource EntryHeading}" FontSize="27" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,0,6"/>
 <Image x:Name="ConnectionStage" Source="ConnectionStage.png" Height="260" Stretch="Uniform" Margin="0,0,0,28" Focusable="False" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
 <Border BorderBrush="{DynamicResource EntryRule}" BorderThickness="1" CornerRadius="16" Background="{DynamicResource EntrySurface}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <RadioButton x:Name="NavConnect" Tag="connect" GroupName="navigation" Style="{StaticResource EntryRole}" Checked="NavigateClick" AutomationProperties.Name="{local:Translate Key='发起连接'}">
 <StackPanel><Path Data="M6,18 L18,6 M7,6 L18,6 L18,17" Style="{StaticResource EntryArrow}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,7" IsHitTestVisible="False"/><TextBlock x:Name="InitiateLabel" Text="{local:Translate Key='发起连接'}" FontSize="17" FontWeight="Normal" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
 </RadioButton>
 <Border Grid.Column="1" Background="{DynamicResource EntryRule}"/>
 <RadioButton Grid.Column="2" x:Name="NavShare" Tag="share" GroupName="navigation" Style="{StaticResource EntryRole}" Checked="NavigateClick" AutomationProperties.Name="{local:Translate Key='接受连接'}">
 <StackPanel><Path Data="M18,6 L6,18 M6,7 L6,18 L17,18" Style="{StaticResource EntryArrow}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,7" IsHitTestVisible="False"/><TextBlock x:Name="AcceptLabel" Text="{local:Translate Key='接受连接'}" FontSize="17" FontWeight="Normal" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
 </RadioButton>
 </Grid></Border>
 <Button x:Name="ActiveSharingShortcut" Content="{local:Translate Key='正在接受连接 · 查看或停止'}" Tag="share" Click="NavigateClick" HorizontalAlignment="Left" Margin="0,22,0,0" Visibility="Collapsed"/>
 <TextBlock x:Name="SessionRoleHint" Text="{local:Translate Key='请先断开当前连接，再切换用途。'}" Visibility="Collapsed" Foreground="#617088" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
 </StackPanel></ScrollViewer>
 <Grid x:Name="ConnectPage" Margin="32,18,22,24" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,24"><TextBlock Text="{local:Translate Key='发起连接'}" FontSize="26" FontWeight="Normal" Foreground="#202D46"/><TextBlock Text="{local:Translate Key='选择你要连接并操作的设备。'}" Foreground="#617088" FontSize="12" Margin="0,8,0,0"/></StackPanel>
 <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,10,12">
 <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
 <Button Click="RefreshDevicesClick" Padding="7,5" Margin="0,0,6,0" AutomationProperties.Name="{local:Translate Key='刷新设备'}" ToolTip="{local:Translate Key='刷新设备'}"><Path Data="M12,4 A5,5 0 1 0 13,9 M9,4 L13,4 L13,0" Stroke="#617088" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform"/></Button>
 <Button x:Name="ManualConnection" Content="{local:Translate Key='添加目标'}" Click="ManualClick" Padding="10,5"/>
 </StackPanel><TextBlock Text="{local:Translate Key='附近设备'}" FontSize="12" Foreground="#617088" VerticalAlignment="Center"/></DockPanel>
 <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="DeviceSearchStatus" Foreground="#697183" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel>
 <Grid>
 <ListBox x:Name="DeviceList" SelectionChanged="DeviceSelected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
 <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate></ListBox.ItemsPanel>
 <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
 <ListBox.ItemTemplate><DataTemplate>
 <Button Click="DeviceConnectClick" Style="{StaticResource DeviceTile}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Address}">
 <Grid><StackPanel>
 <Image Source="DeviceDisplay.png" Width="110" Height="70" HorizontalAlignment="Left" Margin="0,0,0,10" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
 <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
 <TextBlock Text="{Binding SystemLabel}" Foreground="#617088" FontSize="12" Margin="0,5,0,0"/>
 <TextBlock Text="{Binding StateLabel}" Foreground="#617088" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
 </StackPanel>
 <Path Data="M2,2 L7,7 L2,12" Stroke="#6176CB" StrokeThickness="1.5" Width="6" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"/>
 </Grid></Button>
 </DataTemplate></ListBox.ItemTemplate></ListBox>
 <Border x:Name="DeviceEmptyState" Background="#F6F7FA" CornerRadius="10" Padding="24" VerticalAlignment="Top" MinHeight="230">
  <StackPanel VerticalAlignment="Center">
   <Image Source="DeviceDisplay.png" Width="110" Height="74" HorizontalAlignment="Center" Margin="0,0,0,12" IsHitTestVisible="False"/>
   <TextBlock x:Name="DeviceEmptyTitle" Text="{local:Translate Key='暂无设备记录'}" FontWeight="SemiBold" TextAlignment="Center"/>
   <TextBlock Text="{local:Translate Key='让目标设备开始接受连接后刷新，也可以添加目标IP。'}" Foreground="#697183" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,20"/>
  </StackPanel>
 </Border>
 </Grid>
 </DockPanel>
 <TextBlock x:Name="HomeStatus" Grid.Row="1" TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#697183"/>
 <!-- Connection coordinator state; the editable form is shown only on request. -->
 <StackPanel Visibility="Collapsed">
  <TextBlock x:Name="SelectedDeviceName"/><TextBlock x:Name="SelectedDeviceSystem"/>
  <StackPanel x:Name="ConnectionFields">
   <TextBlock x:Name="TargetIpLabel" Text="{local:Translate Key='目标IP'}"/>
   <TextBox x:Name="Address"/><PasswordBox x:Name="Secret"/><CheckBox x:Name="RememberPassword"/>
  </StackPanel>
  <Button x:Name="DiscoverButton" Click="DiscoverClick"/>
  <Button x:Name="StartConnection" Click="ConnectClick"/>
 </StackPanel>
 </Grid></Grid>
 <ContentControl x:Name="SharingPage" Visibility="Collapsed" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
 <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="32,18,32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Text="{local:Translate Key='设置'}" FontSize="26" FontWeight="Normal" Foreground="#202D46" Margin="0,0,0,20"/>
 <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel x:Name="SettingsSections">
 <Border x:Name="GeneralPreferences" Style="{StaticResource PreferenceSection}"><StackPanel>
 <TextBlock Text="{local:Translate Key='通用'}" Style="{StaticResource PreferenceHeading}"/>
 <DockPanel Margin="0,8,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><RadioButton x:Name="LanguageEnglish" Content="English" Tag="en" GroupName="languages" Click="LanguageClick" Margin="0,0,16,0"/><RadioButton x:Name="LanguageChinese" Content="简体中文" Tag="zh-Hans" GroupName="languages" Click="LanguageClick"/></StackPanel><TextBlock Text="{local:Translate Key='语言'}"/></DockPanel>
 </StackPanel></Border>
 <Border x:Name="ConnectionPreferences" Style="{StaticResource PreferenceSection}"><StackPanel>
 <TextBlock Text="{local:Translate Key='连接设置'}" Style="{StaticResource PreferenceHeading}"/>
 <DockPanel Margin="0,8,0,4"><ComboBox x:Name="DefaultQuality" DockPanel.Dock="Right" Width="140" SelectedIndex="0" AutomationProperties.Name="{local:Translate Key='画质'}"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox><TextBlock Text="{local:Translate Key='画质'}" VerticalAlignment="Center"/></DockPanel>
 <CheckBox x:Name="DefaultReconnect" Content="{local:Translate Key='自动重连'}" Style="{StaticResource PreferenceSwitch}"/>
 <CheckBox x:Name="DefaultShortcuts" Content="{local:Translate Key='Windows 快捷键'}" Style="{StaticResource PreferenceSwitch}" ToolTip="{local:Translate Key='Ctrl 对应 Mac Command，Win 对应 Control；Windows 目标使用原生快捷键。'}"/>
 <TextBlock Text="{local:Translate Key='用于下一次连接；当前会话在画面工具栏中调整。'}" Style="{StaticResource PreferenceHelp}"/>
 </StackPanel></Border>
 <Border x:Name="ClipboardPreferences" Style="{StaticResource PreferenceSection}"><StackPanel>
 <TextBlock Text="{local:Translate Key='剪贴板'}" Style="{StaticResource PreferenceHeading}"/>
 <CheckBox x:Name="GlobalClipboard" Content="{local:Translate Key='同步文字'}" IsChecked="True" Style="{StaticResource PreferenceSwitch}"/>
 <CheckBox x:Name="GlobalFiles" Content="{local:Translate Key='同步文件'}" IsChecked="True" Style="{StaticResource PreferenceSwitch}"/>
 <Button Content="{local:Translate Key='打开接收目录'}" Click="OpenFilesClick" Style="{StaticResource QuietAction}" HorizontalAlignment="Left"/>
 <TextBlock Text="{local:Translate Key='关闭后立即停止对应同步；会话选项只能进一步限制共享。'}" Style="{StaticResource PreferenceHelp}"/>
 </StackPanel></Border>
 <Border x:Name="AboutPreferences" BorderThickness="0" Padding="0"><StackPanel>
 <TextBlock Text="{local:Translate Key='关于'}" Style="{StaticResource PreferenceHeading}"/>
 <TextBlock Text="Local Remote Desktop · 0.3.0-alpha.5" FontSize="13" Margin="0,8,0,4"/>
 <TextBlock Text="GPL-3.0-or-later" Foreground="#617088" FontSize="11"/>
 <Expander Header="{local:Translate Key='故障排查'}" FontSize="12" Margin="0,8,0,0"><StackPanel Margin="0,10,0,0">
 <TextBlock x:Name="BuildIdentity" Foreground="#617088" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
 <CheckBox Content="{local:Translate Key='显示性能数据'}" IsChecked="{Binding ElementName=ShowPerformance,Path=IsChecked,Mode=TwoWay}" Margin="0,0,0,12"/>
 <Button Content="{local:Translate Key='复制诊断'}" Click="DiagnosticsClick" HorizontalAlignment="Left"/>
 </StackPanel></Expander>
 </StackPanel></Border>
 </StackPanel></ScrollViewer></Grid>
 </Grid></Grid>
 <DockPanel x:Name="SessionPage" Visibility="Collapsed" Background="White">
  <Grid x:Name="Toolbar" DockPanel.Dock="Top" Margin="12,6" MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <ComboBox x:Name="Quality" SelectedIndex="0" Width="82" Padding="3,3" ToolTip="{local:Translate Key='画质；连接后切换会短暂重连'}" AutomationProperties.Name="{local:Translate Key='画质'}"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox>
    <Button x:Name="FullscreenButton" AutomationProperties.Name="{local:Translate Key='全屏'}" ToolTip="{local:Translate Key='F11 全屏 / 退出全屏'}" Click="FullscreenClick" Padding="7,6" Margin="6,0,2,0"><Path Data="M0,5 L0,0 L5,0 M11,0 L16,0 L16,5 M16,11 L16,16 L11,16 M5,16 L0,16 L0,11" Width="14" Height="14" Stroke="#617088" StrokeThickness="1.4" Stretch="Uniform"/></Button>
     <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13">
      <MenuItem x:Name="SettingsMenu" Header="{local:Translate Key='会话选项'}" ToolTip="{local:Translate Key='仅用于当前连接'}" AutomationProperties.Name="{local:Translate Key='会话选项'}" Padding="10,5">
       <MenuItem Header="{local:Translate Key='剪贴板'}">
        <MenuItem x:Name="ClipboardSync" Header="{local:Translate Key='同步文字'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='同步新复制的纯文本，最多 32 KiB；只对已配对的 Mac 生效。'}"/>
        <MenuItem x:Name="FileSync" Header="{local:Translate Key='同步文件'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='复制普通文件后自动传输；暂不支持文件夹。只对已配对的 Mac 生效。'}"/>
        <Separator/>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock x:Name="ClipboardStatus" Text="{local:Translate Key='文本同步：等待连接'}" FontSize="12"/></MenuItem.Header></MenuItem>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock Text="{Binding ElementName=FileStatus,Path=Text}" FontSize="12"/></MenuItem.Header></MenuItem>
       </MenuItem>
       <MenuItem Header="{local:Translate Key='键盘与连接'}">
        <MenuItem x:Name="WindowsShortcuts" Header="{local:Translate Key='Windows 快捷键'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="{local:Translate Key='Ctrl 对应 Mac Command，Win 对应 Control；关闭后使用原生映射。'}"/>
        <MenuItem x:Name="Reconnect" Header="{local:Translate Key='自动重连'}" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True"/>
       </MenuItem>
       <Separator/>
       <MenuItem Header="{local:Translate Key='打开接收目录'}" Click="OpenFilesClick"/>
       <MenuItem x:Name="ShowPerformance" Header="{local:Translate Key='显示性能数据'}" IsCheckable="True" StaysOpenOnClick="True"/>
       <MenuItem Header="{local:Translate Key='复制诊断'}" Click="DiagnosticsClick"/>
       <Separator/>
       <MenuItem Header="{local:Translate Key='设置'}" Click="SessionSettingsClick"/>
      </MenuItem>
     </Menu>
    <Button x:Name="ConnectButton" Content="{local:Translate Key='连接'}" Click="ConnectClick" Margin="6,0,0,0" Padding="10,5"/>
   </StackPanel>
   <Grid Margin="0,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="SessionHome" Click="HomeBackClick" ToolTip="{local:Translate Key='首页'}" AutomationProperties.Name="{local:Translate Key='首页'}" Padding="7" Margin="0,0,10,0" VerticalAlignment="Center"><Path Data="M1,8 L8,1 L15,8 M3,6 L3,15 L7,15 L7,10 L10,10 L10,15 L13,15 L13,6" Width="15" Height="15" Stroke="#617088" StrokeThickness="1.4" Stretch="Uniform"/></Button>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ConnectionTarget" Visibility="Collapsed" TextTrimming="CharacterEllipsis" FontSize="13"/>
    <TextBlock x:Name="SessionState" Foreground="#617088" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
   </Grid>
  </Grid>
   <DockPanel x:Name="TransferNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,0,12,8">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button x:Name="CancelFiles" Content="{local:Translate Key='取消传输'}" Click="CancelFilesClick" IsEnabled="False" Visibility="Collapsed" Margin="8,0" Padding="6,2"/>
     <Button x:Name="DismissFileNotice" Content="{local:Translate Key='收起'}" Click="DismissFilesClick" Padding="6,2"/>
    </StackPanel>
    <TextBlock x:Name="FileStatus" Text="{local:Translate Key='文件同步：等待连接'}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="{local:Translate Key='输入目标IP和配对密码，连接后点击画面开始操作。'}" Margin="12,6" FontSize="11" Foreground="#617088" TextWrapping="Wrap"/>
  <Border x:Name="ViewOnlyNotice" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFF8E7" Padding="12,7"><TextBlock Text="{local:Translate Key='目标设备尚未允许控制；当前只能查看。'}" TextWrapping="Wrap" FontSize="12"/></Border>
  <Grid Background="#111827">
   <Border x:Name="Surface" Background="Black" Focusable="True" ClipToBounds="True" InputMethod.IsInputMethodEnabled="False" KeyboardNavigation.TabNavigation="None"><Image x:Name="Desktop" Stretch="Uniform"/></Border>
   <Border x:Name="SessionNotice" Visibility="Collapsed" Background="#111827" Padding="24"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
    <TextBlock x:Name="SessionNoticeTitle" Foreground="White" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding ElementName=Status,Path=Text}" Foreground="#CBD5E1" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></Border>
  </Grid>
 </DockPanel>
 <Grid x:Name="ManualDialog" Visibility="Collapsed" Background="#66000000" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" PreviewKeyDown="ManualKeyDown">
  <Border Background="White" BorderBrush="#E5E8F0" BorderThickness="1" CornerRadius="16,16,0,0" MaxWidth="520" MaxHeight="600" Margin="16,16,16,0" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
   <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
     <Button x:Name="ManualCancel" Content="{local:Translate Key='取消'}" Click="ManualCancelClick" Margin="0,0,8,0"/>
     <Button x:Name="ManualConnect" Content="{local:Translate Key='连接'}" Click="ManualConnectClick" Style="{StaticResource BrandConnectButton}"/>
    </StackPanel>
   <ScrollViewer x:Name="ManualFieldsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="{local:Translate Key='连接设备'}" FontSize="24" FontWeight="Normal" Margin="0,0,0,12"/>
    <TextBlock x:Name="ManualDeviceName" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="ManualDeviceSystem" Foreground="#697183" FontSize="12" Margin="0,4,0,16" TextWrapping="Wrap"/>
    <TextBlock Text="{local:Translate Key='目标IP'}" Margin="0,0,0,6"/>
    <TextBox x:Name="ManualAddress" Padding="8" MaxLength="15" TextChanged="ManualAddressChanged" AutomationProperties.Name="{local:Translate Key='目标IP'}"/>
    <TextBlock Text="{local:Translate Key='密码'}" Margin="0,12,0,6"/>
    <PasswordBox x:Name="ManualSecret" Padding="8" MaxLength="64" AutomationProperties.Name="{local:Translate Key='密码'}"/>
    <CheckBox x:Name="ManualRemember" Content="{local:Translate Key='记住密码'}" Margin="0,10,0,0"/>
    <TextBlock Text="{local:Translate Key='认证成功后安全保存。'}" Foreground="#697183" FontSize="12" Margin="0,6,0,0"/>
 <TextBlock Text="{local:Translate Key='画质'}" Margin="0,12,0,6"/><ComboBox x:Name="HomeQuality" SelectedIndex="0" Padding="4"><ComboBoxItem Content="{local:Translate Key='流畅'}"/><ComboBoxItem Content="{local:Translate Key='标准'}"/><ComboBoxItem Content="{local:Translate Key='高清'}"/></ComboBox>
 <Button x:Name="ForgetButton" Content="{local:Translate Key='忘记密码'}" Click="ManualForgetClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    <CheckBox x:Name="ManualStopSharing" Content="{local:Translate Key='停止接受连接并连接'}" Margin="0,10,0,0" Visibility="Collapsed"/>
    <TextBlock x:Name="ManualError" TextWrapping="Wrap" Foreground="#A82435" Margin="0,10,0,0"/>

   </StackPanel></ScrollViewer>
   </DockPanel>
  </Border>
 </Grid>
 </Grid>
</Window>
