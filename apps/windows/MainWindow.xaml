<Window x:Class="LocalRemote.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LocalRemote · 0.1.0" Icon="LocalRemote.ico" Width="1280" Height="760" MinWidth="720" MinHeight="480" Background="#F7F8FF" Foreground="#282C67" FontFamily="Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5265EC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
  <Style TargetType="TextBox"><Setter Property="SelectionBrush" Value="#5265EC"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="SelectionBrush" Value="#5265EC"/></Style>
  <Style x:Key="BrandConnectButton" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#5265EC" Offset="0"/><GradientStop Color="#643AC2" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#4B50CE"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#4238AF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel>
  <DockPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="10,6,10,6">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="FullscreenButton" Content="全屏" ToolTip="F11 全屏 / 退出全屏" Click="FullscreenClick" Padding="8,4" Margin="8,0,6,0"/>
     <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13">
      <MenuItem x:Name="SettingsMenu" Header="设置" Padding="10,5">
       <MenuItem Header="剪贴板">
        <MenuItem x:Name="ClipboardSync" Header="同步文字" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="同步新复制的纯文本，最多 32 KiB；只对已配对的 Mac 生效。"/>
        <MenuItem x:Name="FileSync" Header="同步文件" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="复制普通文件后自动传输；暂不支持文件夹。只对已配对的 Mac 生效。"/>
        <Separator/>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock x:Name="ClipboardStatus" Text="文本同步：等待连接" FontSize="12"/></MenuItem.Header></MenuItem>
        <MenuItem IsEnabled="False"><MenuItem.Header><TextBlock Text="{Binding ElementName=FileStatus,Path=Text}" FontSize="12"/></MenuItem.Header></MenuItem>
       </MenuItem>
       <MenuItem Header="键盘与连接">
        <MenuItem x:Name="WindowsShortcuts" Header="Windows 快捷键" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" ToolTip="Ctrl 对应 Mac Command，Win 对应 Control；关闭后使用原生映射。"/>
        <MenuItem x:Name="Reconnect" Header="自动重连" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True"/>
        <Separator/>
        <MenuItem x:Name="ForgetButton" Header="忘记此连接" Click="ForgetClick"/>
       </MenuItem>
       <Separator/>
       <MenuItem Header="打开接收目录" Click="OpenFilesClick"/>
       <MenuItem x:Name="ShowPerformance" Header="显示性能数据" IsCheckable="True" StaysOpenOnClick="True"/>
       <MenuItem Header="复制诊断" Click="DiagnosticsClick"/>
      </MenuItem>
     </Menu>
   </StackPanel>
   <WrapPanel VerticalAlignment="Center">
    <StackPanel x:Name="ConnectionFields" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
     <TextBlock Text="Mac IP" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>
     <TextBox x:Name="Address" Width="126" Padding="4,4" ToolTip="Mac 的局域网 IPv4；优先填写上次记住的地址"/>
     <TextBlock Text="密钥" VerticalAlignment="Center" Margin="8,0,5,0" FontSize="12"/>
     <PasswordBox x:Name="Secret" Width="128" Padding="4,4" ToolTip="粘贴 Mac 上显示的配对密钥"/>
    </StackPanel>
    <TextBlock x:Name="ConnectionTarget" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ComboBox x:Name="Quality" SelectedIndex="0" Width="74" Padding="3,3" ToolTip="画质；连接后切换会短暂重连"><ComboBoxItem>流畅</ComboBoxItem><ComboBoxItem>标准</ComboBoxItem><ComboBoxItem>高清</ComboBoxItem></ComboBox>
    <Button x:Name="ConnectButton" Content="连接" Click="ConnectClick" Margin="6,0,0,0" Padding="12,5" Style="{StaticResource BrandConnectButton}"/>
   </WrapPanel>
  </DockPanel>
   <DockPanel x:Name="TransferNotice" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,0,12,8">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button x:Name="CancelFiles" Content="取消传输" Click="CancelFilesClick" IsEnabled="False" Visibility="Collapsed" Margin="8,0" Padding="6,2"/>
     <Button x:Name="DismissFileNotice" Content="收起" Click="DismissFilesClick" Padding="6,2"/>
    </StackPanel>
    <TextBlock x:Name="FileStatus" Text="文件同步：等待连接" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
   </DockPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="输入 Mac 地址和配对密钥，连接后点击画面开始操作。" Margin="12,8" TextWrapping="Wrap"/>
  <Border x:Name="Surface" Background="Black" Focusable="True" ClipToBounds="True" InputMethod.IsInputMethodEnabled="False" KeyboardNavigation.TabNavigation="None"><Image x:Name="Desktop" Stretch="Uniform"/></Border>
 </DockPanel>
</Window>
