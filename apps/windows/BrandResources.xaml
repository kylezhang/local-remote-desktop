<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DrawingImage x:Key="SettingsVector"><DrawingImage.Drawing><DrawingGroup>
   <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#697183" Thickness="1.6" LineJoin="Round"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><PathGeometry Figures="M18.56 9.28 L20.86 10.44 20.86 13.56 18.56 14.72 19.37 17.16 17.16 19.37 14.72 18.56 13.56 20.86 10.44 20.86 9.28 18.56 6.84 19.37 4.63 17.16 5.44 14.72 3.14 13.56 3.14 10.44 5.44 9.28 4.63 6.84 6.84 4.63 9.28 5.44 10.44 3.14 13.56 3.14 14.72 5.44 17.16 4.63 19.37 6.84 Z"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#697183" Thickness="1.6"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="3.1" RadiusY="3.1"/></GeometryDrawing.Geometry></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#5265EC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
  <Style TargetType="TextBox"><Setter Property="SelectionBrush" Value="#5265EC"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="SelectionBrush" Value="#5265EC"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#202435"/><Setter Property="BorderBrush" Value="#E5E8F0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="OrdinaryButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OrdinaryButton" Property="Background" Value="#EBEEFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="OrdinaryButton" Property="Background" Value="#DFE4FF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OrdinaryButton" Property="BorderBrush" Value="#5265EC"/><Setter TargetName="OrdinaryButton" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="BrandConnectButton" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Background" Value="#5265EC"/><Setter Property="Padding" Value="14,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#4B50CE"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#4238AF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#202435"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

 <Style TargetType="TabItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#EEF0FF"/><Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="#3449BF"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#5265EC"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="White" BorderBrush="#E5E8F0" BorderThickness="0,0,0,1" CornerRadius="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F3FF"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F6F7FA"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#5265EC"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="NavigationItem" TargetType="RadioButton">
  <Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="12,14"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Item" Padding="{TemplateBinding Padding}" CornerRadius="9" Background="Transparent"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Item" Property="Background" Value="#EBEEFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#ECEFF5"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#5265EC"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="SettingsShortcut" TargetType="RadioButton">
 <Setter Property="Foreground" Value="#697183"/>
 <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Shortcut" Background="White" CornerRadius="7" BorderThickness="1" BorderBrush="#E8EBF3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shortcut" Property="Background" Value="#F6F7FB"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shortcut" Property="BorderBrush" Value="#5265EC"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <SolidColorBrush x:Key="EntryInk" Color="#202D46"/>
 <SolidColorBrush x:Key="EntryAccent" Color="#5265EC"/>
 <SolidColorBrush x:Key="EntryRule" Color="#DFE5EF"/>
 <SolidColorBrush x:Key="EntrySurface" Color="#FAFBFE"/>
 <Style x:Key="EntryHeading" TargetType="TextBlock">
 <Setter Property="Foreground" Value="{DynamicResource EntryInk}"/>
 <Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
 <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
 </DataTrigger></Style.Triggers></Style>
 <Style x:Key="EntryArrow" TargetType="Path">
 <Setter Property="Stroke" Value="{DynamicResource EntryAccent}"/>
 <Style.Triggers><DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
 <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
 </DataTrigger></Style.Triggers></Style>
 <Style x:Key="EntryRole" TargetType="RadioButton">
 <Setter Property="Foreground" Value="{DynamicResource EntryInk}"/>
 <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="76"/><Setter Property="Padding" Value="10,15"/>
 <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
 <Grid>
 <Border x:Name="Tile" CornerRadius="15,0,0,15" Background="{DynamicResource EntrySurface}" Padding="{TemplateBinding Padding}">
 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
 </Border>
 <Border x:Name="FocusRing" CornerRadius="12" Margin="3" BorderBrush="{DynamicResource EntryAccent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
 </Grid><ControlTemplate.Triggers>
 <Trigger Property="Tag" Value="share"><Setter TargetName="Tile" Property="CornerRadius" Value="0,15,15,0"/></Trigger>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#EEF2FF"/></Trigger>
 <Trigger Property="IsPressed" Value="True"><Setter TargetName="Tile" Property="Background" Value="#E9EDFF"/></Trigger>
 <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
 <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
 <Setter TargetName="Tile" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
 <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
 <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
 </DataTrigger>
 <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary>
