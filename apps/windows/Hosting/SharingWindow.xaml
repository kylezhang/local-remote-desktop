<Window x:Class="LocalRemoteDesktop.SharingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalRemoteDesktop" Title="Local Remote Desktop" Icon="/LocalRemoteDesktop;component/LocalRemoteDesktop.ico" SizeToContent="Height" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#FFFFFF" Foreground="#202435" FontFamily="{x:Static local:UiTypography.Family}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/LocalRemoteDesktop;component/BrandResources.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <DockPanel>
 <Border DockPanel.Dock="Bottom" BorderBrush="#E5E8F0" BorderThickness="0" Padding="0,16,0,0" Margin="32,0,32,24" MaxWidth="640" HorizontalAlignment="Stretch">
  <Button x:Name="SharingStart" Style="{StaticResource BrandConnectButton}" Content="{local:Translate Key='开始接受连接'}" HorizontalAlignment="Stretch" MinHeight="45" Padding="12,10" Click="StartClick"/>
 </Border>
 <ScrollViewer x:Name="SharingScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SharingLayout" Margin="32,16,32,16" MaxWidth="640" HorizontalAlignment="Stretch">
  <TextBlock Text="{local:Translate Key='接受连接'}" FontSize="26" FontWeight="Normal" Margin="0,0,0,8"/>
  <TextBlock Text="{local:Translate Key='让另一台设备连接并操作你的当前屏幕。'}" TextWrapping="Wrap" FontSize="12" Foreground="#617088" Margin="0,0,0,12"/>
  <StackPanel Margin="0,8,0,0">
  <Border x:Name="SharingDeviceSurface" Background="Transparent" CornerRadius="15" Padding="0" VerticalAlignment="Top"><StackPanel>
  <Border HorizontalAlignment="Center" CornerRadius="12" BorderBrush="#DFE5EF" BorderThickness="1" Padding="10,4" Margin="0,0,0,8">
   <TextBlock x:Name="SharingStatus" TextWrapping="Wrap" TextAlignment="Center" FontSize="11"/>
  </Border>
  <Image Source="/LocalRemoteDesktop;component/DeviceDisplay.png" Width="112" Height="64" IsHitTestVisible="False"/>
  <TextBlock Text="{local:Translate Key='本机名称'}" Foreground="#617088" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,3"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
   <TextBlock x:Name="SharingName" TextWrapping="Wrap" MaxWidth="310" FontSize="19" VerticalAlignment="Center"/>
   <Button x:Name="ChangeDeviceName" Content="{local:Translate Key='修改名称'}" Click="NameEditClick" Style="{StaticResource QuietAction}" Margin="6,0,0,0"/>
  </StackPanel>
  <StackPanel x:Name="NameEditor" Visibility="Collapsed" Margin="0,0,0,16">
   <TextBlock Text="{local:Translate Key='显示在其他设备的列表中，默认使用系统本机名称。'}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBox x:Name="NameDraft" Padding="6" AutomationProperties.Name="{local:Translate Key='本机名称'}"/>
   <Button x:Name="RestoreDeviceName" Content="{local:Translate Key='使用系统名称'}" Click="NameRestoreClick" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   <TextBlock x:Name="NameError" TextWrapping="Wrap" Foreground="#A82435" Margin="0,6"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelDeviceName" Content="{local:Translate Key='取消'}" Click="NameCancelClick" Margin="0,0,8,0"/>
    <Button x:Name="SaveDeviceName" Content="{local:Translate Key='保存名称'}" Click="NameSaveClick" Style="{StaticResource BrandConnectButton}"/>
   </StackPanel>
  </StackPanel>
  <Border BorderBrush="#DFE5EF" BorderThickness="1" CornerRadius="15" Padding="16,12"><StackPanel>
  <TextBlock Text="{local:Translate Key='本机 IP'}" FontSize="12" Foreground="#697183" Margin="0,0,0,6"/>
  <TextBlock x:Name="SharingAddress" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock x:Name="DiscoveryNotice" Text="{local:Translate Key='设备发现不可用；仍可通过目标IP连接。'}" Visibility="Collapsed" Foreground="#697183" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <Separator Background="#E5E8F0" Margin="0,10,0,10"/>
  <Border x:Name="SharingPasswordSurface"><StackPanel>
  <TextBlock Text="{local:Translate Key='连接本设备时，使用下方密码。'}" Foreground="#697183" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <DockPanel>
   <Button x:Name="ChangeSharingPassword" DockPanel.Dock="Right" Content="{local:Translate Key='修改密码…'}" Click="EditClick" Padding="8,4"/>
   <TextBlock Text="{local:Translate Key='当前密码'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <DockPanel Margin="0,10,0,0">
   <Button DockPanel.Dock="Right" Content="{local:Translate Key='复制'}" Click="CopyClick" Padding="8,4" Margin="6,0,0,0"/>
   <Button x:Name="Reveal" DockPanel.Dock="Right" Content="{local:Translate Key='查看'}" Click="RevealClick" Padding="8,4" Margin="6,0,0,0"/>
   <TextBlock x:Name="CurrentPassword" Text="••••••••" FontFamily="Consolas" FontSize="20" VerticalAlignment="Center" TextWrapping="Wrap"/>
  </DockPanel>
  <StackPanel x:Name="Editor" Visibility="Collapsed" Margin="0,14,0,0">
   <TextBlock Text="{local:Translate Key='新密码'}" FontWeight="SemiBold"/>
   <DockPanel Margin="0,6,0,6">
    <Button x:Name="GenerateSharingPassword" DockPanel.Dock="Right" Content="{local:Translate Key='↻ 自动生成'}" Click="GenerateClick" Margin="6,0,0,0" Padding="8,4"/>
    <TextBox x:Name="Draft" Padding="5" MaxLength="8"/>
   </DockPanel>
   <TextBlock Text="{local:Translate Key='8 位英文字母、数字或符号，不含空格。'}" FontSize="12" TextWrapping="Wrap"/>
   <TextBlock x:Name="PasswordError" Foreground="#A82435" TextWrapping="Wrap" Margin="0,6,0,6"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelSharingPassword" Content="{local:Translate Key='取消'}" Click="CancelEditClick" Padding="8,4" Margin="0,0,6,0"/>
    <Button x:Name="SaveSharingPassword" Style="{StaticResource BrandConnectButton}" Content="{local:Translate Key='保存密码'}" Click="SaveClick" Padding="8,4"/>
   </StackPanel>
  </StackPanel>
  </StackPanel></Border>
  </StackPanel></Border>
  </StackPanel></Border>
  </StackPanel>
  <Border x:Name="SharingTransfer" Visibility="Collapsed" Background="#F6F7FA" CornerRadius="6" Padding="10" Margin="0,14,0,0"><DockPanel>
   <Button x:Name="CancelSharingFiles" DockPanel.Dock="Right" Content="{local:Translate Key='取消'}" Click="CancelSharingFilesClick" Padding="8,4"/>
   <Button x:Name="DismissSharingFiles" DockPanel.Dock="Right" Content="{local:Translate Key='关闭'}" Click="DismissSharingFilesClick" Padding="8,4" Margin="6,0"/>
   <Button DockPanel.Dock="Right" Content="{local:Translate Key='打开接收目录'}" Click="OpenSharingFilesClick" Padding="8,4" Margin="6,0"/>
   <TextBlock x:Name="SharingFileStatus" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel></Border>
  <Expander x:Name="SharingTroubleshooting" Header="{local:Translate Key='故障排查'}" Margin="0,18,0,0"><StackPanel>
  <TextBlock x:Name="SharingError" Visibility="Collapsed" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,8"/>
  <Button Content="{local:Translate Key='复制共享诊断'}" Click="CopySharingDiagnosticsClick" HorizontalAlignment="Left" Margin="0,8,0,0"/>
  <CheckBox x:Name="Software" Content="{local:Translate Key='使用软件编码'}" ToolTip="{local:Translate Key='默认使用 Media Foundation 硬件 H.264；硬件不支持时停止接受连接后选择此项。'}" Margin="0,18,0,10"/>
  <TextBlock Text="{local:Translate Key='硬件编码不可用时再开启；需停止接受连接后切换，CPU 占用较高。'}" FontSize="12" Foreground="#697183" TextWrapping="Wrap"/>
  </StackPanel></Expander>
 </StackPanel></ScrollViewer>
 </DockPanel>
</Window>
