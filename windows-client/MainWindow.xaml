<Window x:Class="RemoteMacLAN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LocalRemote · 0.1.0" Icon="LocalRemote.ico" Width="1280" Height="760" MinWidth="720" MinHeight="480" Background="#FFF7FA" Foreground="#683247" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="CherryConnectButton" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AC5974" Offset="0"/><GradientStop Color="#A4546B" Offset="0.55"/><GradientStop Color="#84354F" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel>
  <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="12,8,12,10">
   <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
    <Image x:Name="BrandLogo" Source="LocalRemote.png" Width="48" Height="48" Margin="0,0,10,0" AutomationProperties.Name="LocalRemote"/>
    <TextBlock Text="LocalRemote" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
   <WrapPanel VerticalAlignment="Center">
   <TextBox x:Name="Address" Width="155" ToolTip="优先填入上次记住的 Mac IP；首次使用填入本机局域网 IPv4"/>
   <PasswordBox x:Name="Secret" Width="200" Margin="8,0" ToolTip="Paste the 64-character pairing key shown on Mac"/>
   <ComboBox x:Name="Quality" SelectedIndex="0" Width="85" ToolTip="连接后也可切换；会短暂断开并自动按新画质重新连接"><ComboBoxItem>流畅</ComboBoxItem><ComboBoxItem>标准</ComboBoxItem><ComboBoxItem>高清</ComboBoxItem></ComboBox>
   <Button x:Name="ConnectButton" Content="连接" Click="ConnectClick" Margin="8,0" Padding="16,5" Style="{StaticResource CherryConnectButton}"/>
   <Button x:Name="ForgetButton" Content="忘记连接" Click="ForgetClick" Margin="0,0,8,0" Padding="8,4"/>
   <Button Content="全屏 F11" Click="FullscreenClick" Padding="8,4"/>
   <Button Content="复制诊断" Click="DiagnosticsClick" Padding="8,4" Margin="8,0,0,0"/>
   <CheckBox x:Name="Reconnect" Content="自动重连" IsChecked="True" VerticalAlignment="Center" Margin="8,0"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="填写 Mac IP 和配对密钥。Ctrl+Alt+Esc 释放输入；F11 切换全屏。" Margin="12,8" TextWrapping="Wrap"/>
  <Border x:Name="Surface" Background="Black" Focusable="True" ClipToBounds="True" InputMethod.IsInputMethodEnabled="False" KeyboardNavigation.TabNavigation="None"><Image x:Name="Desktop" Stretch="Uniform"/></Border>
 </DockPanel>
</Window>
